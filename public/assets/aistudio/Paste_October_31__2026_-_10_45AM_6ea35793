<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Hydro Detailing Brisbane | Premium Mobile Car Detailing</title>
<meta name="description" content="Premium mobile car detailing across Brisbane, Springfield, Ipswich and surrounds. Interior details, paint correction and ceramic coating. Book online." />
<link rel="icon" href="https://media.base44.com/images/public/6a1ff5a5ebbdcf02189dae7e/eca68586a_41CCB282-7922-44D3-BBDA-4897CB99DAF7__1_.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --navy:#001F3F;
  --blue:#0066CC;
  --sky:#4DA6FF;
  --tint:#F0F7FF;
  --muted:#5d7690;
  --line:rgba(0,102,204,.12);
  --line-strong:rgba(0,102,204,.3);
  --radius:1rem;
  --shadow:0 18px 50px -20px rgba(0,31,63,.25);
  --font-h:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;
  --font-b:'Inter',system-ui,-apple-system,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:var(--font-b);color:var(--navy);background:#fff;
  -webkit-font-smoothing:antialiased;line-height:1.6;
}
h1,h2,h3,h4,h5{font-family:var(--font-h);margin:0;line-height:1.1;letter-spacing:-.02em}
p{margin:0}
a{text-decoration:none;color:inherit}
img{display:block;max-width:100%}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,select,textarea{font:inherit;color:inherit}
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 20px}
.muted{color:var(--muted)}
.eyebrow{color:var(--blue);font-weight:600;font-size:.8rem;letter-spacing:.18em;text-transform:uppercase}
.h2{font-size:clamp(2rem,5vw,3.4rem);font-weight:800}
.lead{color:var(--muted);font-size:1.075rem}
section{position:relative}
.pad{padding:96px 0}
@media(min-width:640px){.pad{padding:128px 0}}

/* ============ BUTTONS ============ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:999px;
  padding:.8rem 1.6rem;font-weight:600;font-size:.95rem;transition:.3s ease;white-space:nowrap}
.btn svg{width:1rem;height:1rem;flex:none}
.btn-navy{background:var(--navy);color:#fff;box-shadow:0 14px 30px -14px rgba(0,31,63,.7)}
.btn-navy:hover{background:var(--blue);box-shadow:0 14px 30px -12px rgba(0,102,204,.6)}
.btn-blue{background:var(--blue);color:#fff;box-shadow:0 16px 34px -16px rgba(0,102,204,.85)}
.btn-blue:hover{background:var(--sky)}
.btn-outline{border:1.5px solid var(--line-strong);color:var(--blue);background:#fff}
.btn-outline:hover{background:rgba(0,102,204,.06)}
.btn-ghost-light{border:1.5px solid rgba(255,255,255,.35);color:#fff}
.btn-ghost-light:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.6)}
.btn-lg{padding:1rem 2rem;font-size:1rem}
.btn:disabled{opacity:.4;cursor:not-allowed}

/* ============ PROMO BANNER ============ */
.promo{position:relative;overflow:hidden;color:#fff;text-align:center;font-size:.78rem;padding:.55rem 1rem;
  background:linear-gradient(135deg,#001F3F 0%,#0044AA 40%,#0066CC 60%,#001F3F 100%)}
.promo-top{position:absolute;inset:0 0 auto 0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent)}
.promo-row{position:relative;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.4rem .5rem}
.promo .tag{color:#FDE68A;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.promo .count{display:inline-flex;align-items:center;gap:.25rem;background:rgba(253,224,71,.18);
  border:1px solid rgba(253,224,71,.4);border-radius:.6rem;padding:.05rem .5rem;color:#FDE68A;
  font-weight:700;font-variant-numeric:tabular-nums;font-size:.72rem}

/* ============ HEADER ============ */
.site-header{position:fixed;top:0;left:0;right:0;z-index:60;transition:.4s ease}
.site-header.scrolled{background:rgba(255,255,255,.92);backdrop-filter:blur(18px);
  box-shadow:0 12px 30px -20px rgba(0,102,204,.5);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px}
.brand{display:flex;align-items:center;gap:.6rem}
.brand img{width:40px;height:40px;object-fit:contain}
.brand-name{font-family:var(--font-h);font-weight:800;font-size:1.05rem;letter-spacing:-.02em;color:#fff;transition:.4s}
.brand-name span{font-weight:500;color:var(--sky)}
.scrolled .brand-name{color:var(--navy)}
.scrolled .brand-name span{color:var(--blue)}
.nav-links{display:none;gap:2rem;align-items:center}
.nav-links button,.nav-links a{font-size:.9rem;font-weight:500;color:rgba(255,255,255,.85);transition:.25s}
.nav-links button:hover,.nav-links a:hover{color:#fff}
.scrolled .nav-links button,.scrolled .nav-links a{color:rgba(0,31,63,.72)}
.scrolled .nav-links button:hover,.scrolled .nav-links a:hover{color:var(--blue)}
.nav-right{display:none;align-items:center;gap:.75rem}
.nav-phone{display:inline-flex;align-items:center;gap:.4rem;font-weight:500;font-size:.9rem;color:#fff}
.nav-phone svg{width:1rem;height:1rem}
.scrolled .nav-phone{color:var(--navy)}
.burger{display:inline-flex;padding:.4rem;color:#fff}
.scrolled .burger{color:var(--navy)}
@media(min-width:900px){
  .nav-links,.nav-right{display:flex}
  .burger{display:none}
}
.mobile-menu{position:fixed;inset:0;z-index:55;background:var(--navy);padding:96px 24px 24px;
  display:none;flex-direction:column;gap:.25rem}
.mobile-menu.open{display:flex}
.mobile-menu button,.mobile-menu a{text-align:left;color:rgba(255,255,255,.85);font-size:1.1rem;
  font-weight:500;padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.1)}
.mobile-menu .btn{margin-top:1.25rem;border-bottom:0;color:#fff}

/* ============ HERO ============ */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden}
.hero-bg{position:absolute;inset:0}
.hero-bg img{width:100%;height:100%;object-fit:cover}
.hero-bg::after{content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(0,31,63,.92),rgba(0,31,63,.72) 55%,rgba(0,31,63,.4))}
.hero-bg::before{content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(0deg,rgba(0,31,63,.65),transparent 60%)}
.watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  pointer-events:none;overflow:hidden}
.watermark span{font-family:var(--font-h);font-weight:800;font-size:20vw;letter-spacing:-.05em;
  color:rgba(255,255,255,.035);white-space:nowrap;user-select:none}
.hero-inner{position:relative;z-index:5;width:100%;padding:140px 0 90px}
.rating-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.45rem 1rem;border-radius:999px;
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(12px);
  color:rgba(255,255,255,.92);font-size:.82rem;font-weight:500;margin-bottom:2rem}
.stars{display:inline-flex;gap:2px}
.stars svg{width:14px;height:14px;fill:#FACC15;color:#FACC15}
.hero h1{color:#fff;font-weight:800;font-size:clamp(2.5rem,7vw,5rem);line-height:.96}
.hero h1 em{font-style:normal;color:var(--sky)}
.hero p{color:rgba(255,255,255,.72);font-weight:300;font-size:1.1rem;max-width:34rem;margin-top:1.5rem}
.hero-cta{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2.5rem}
.trust{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:3.5rem;color:rgba(255,255,255,.55);font-size:.85rem}
.trust span{display:inline-flex;align-items:center;gap:.5rem}
.trust i{width:6px;height:6px;border-radius:999px;background:var(--sky);display:inline-block}
.scroll-hint{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:none}
@media(min-width:640px){.scroll-hint{display:block}}
.scroll-hint div{width:24px;height:40px;border:2px solid rgba(255,255,255,.3);border-radius:999px;
  display:flex;justify-content:center;padding-top:6px}
.scroll-hint i{width:4px;height:8px;border-radius:999px;background:rgba(255,255,255,.6);
  animation:bob 2s infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}

/* ============ SECTIONS ============ */
.grad-a{background:linear-gradient(180deg,#fff,#F0F7FF)}
.grad-b{background:linear-gradient(180deg,#F0F7FF,#fff)}
.center-head{text-align:center;max-width:44rem;margin:0 auto 3.5rem}
.center-head .h2{margin-top:.75rem}
.center-head .lead{margin-top:1rem}
.watermark-dark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  pointer-events:none;overflow:hidden}
.watermark-dark span{font-family:var(--font-h);font-weight:800;font-size:16vw;letter-spacing:-.05em;
  color:rgba(0,102,204,.03);white-space:nowrap;user-select:none}

/* reveal animation */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

/* ============ SERVICE CARDS ============ */
.grid-3{display:grid;gap:2rem;grid-template-columns:1fr}
@media(min-width:768px){.grid-3{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.grid-3{grid-template-columns:repeat(3,1fr)}}
.svc{background:#fff;border:1px solid var(--line);border-radius:1.25rem;overflow:hidden;display:flex;
  flex-direction:column;transition:.45s ease;box-shadow:0 2px 10px -6px rgba(0,31,63,.15)}
.svc:hover{border-color:var(--line-strong);box-shadow:0 26px 50px -30px rgba(0,102,204,.6);transform:translateY(-3px)}
.svc-img{position:relative;height:190px;overflow:hidden}
.svc-img img{width:100%;height:100%;object-fit:cover;transition:.8s ease}
.svc:hover .svc-img img{transform:scale(1.06)}
.badge{position:absolute;top:1rem;left:1rem;padding:.3rem .8rem;border-radius:999px;color:#fff;
  font-size:.72rem;font-weight:700;letter-spacing:.02em;box-shadow:0 8px 20px -10px rgba(0,0,0,.6)}
.svc-body{padding:1.5rem;display:flex;flex-direction:column;flex:1}
.svc-body>p{color:var(--muted);font-size:.88rem;margin-bottom:1rem}
.prices{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.25rem}
.price-pill{flex:1;min-width:78px;background:var(--tint);border:1px solid rgba(0,102,204,.06);
  border-radius:.8rem;padding:.6rem .4rem;text-align:center}
.price-pill .lbl{font-size:.66rem;color:var(--muted);line-height:1.2}
.price-pill .val{font-weight:700;color:var(--navy);font-size:1.02rem}
.includes{display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.5rem}
.includes div{display:flex;gap:.5rem;align-items:flex-start;font-size:.82rem;color:rgba(0,31,63,.72)}
.includes svg{width:14px;height:14px;color:var(--blue);flex:none;margin-top:.18rem}
.more{font-size:.76rem;color:var(--blue);font-weight:600;padding-left:1.35rem}
.svc-actions{display:flex;gap:.5rem;margin-top:auto}
.svc-actions .btn{flex:1;padding:.65rem 1rem;font-size:.84rem;border-radius:.8rem}

/* ============ WHY US ============ */
.grid-why{display:grid;gap:1.5rem;grid-template-columns:1fr}
@media(min-width:640px){.grid-why{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.grid-why{grid-template-columns:repeat(3,1fr)}}
.why{position:relative;padding:2rem;border-radius:1.25rem;border:1px solid var(--line);
  background:linear-gradient(135deg,#fff,rgba(240,247,255,.6));transition:.45s ease}
.why:hover{border-color:var(--line-strong);box-shadow:0 24px 40px -30px rgba(0,102,204,.6);transform:translateY(-3px)}
.why .num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;
  border-radius:.75rem;background:rgba(0,102,204,.1);color:var(--blue);font-family:var(--font-h);
  font-weight:800;font-size:.95rem;margin-bottom:1.25rem;transition:.4s}
.why:hover .num{background:var(--blue);color:#fff}
.why h3{font-size:1.05rem;font-weight:700;margin-bottom:.4rem}
.why p{color:var(--muted);font-size:.88rem}

/* ============ REVIEWS ============ */
.grid-rev{display:grid;gap:1.5rem;max-width:1100px;margin:0 auto}
@media(min-width:768px){.grid-rev{grid-template-columns:repeat(3,1fr)}}
.rev{position:relative;background:#fff;border:1px solid var(--line);border-radius:1.5rem;padding:2rem;
  box-shadow:0 24px 50px -40px rgba(0,102,204,.9)}
.rev .quote{position:absolute;top:1.5rem;right:1.5rem;font-family:var(--font-h);font-size:3rem;
  line-height:1;color:rgba(0,102,204,.1)}
.rev .stars{margin-bottom:1rem}
.rev .stars svg{width:15px;height:15px}
.rev blockquote{margin:0;font-style:italic;font-weight:300;font-size:.95rem;color:var(--navy)}
.rev-meta{display:flex;align-items:center;gap:.75rem;margin-top:1.5rem}
.avatar{width:40px;height:40px;border-radius:999px;display:grid;place-items:center;color:#fff;
  font-weight:700;background:linear-gradient(135deg,var(--blue),var(--sky))}
.rev-name{font-family:var(--font-h);font-weight:700;font-size:.85rem}
.rev-sub{font-size:.72rem;color:var(--muted)}

/* ============ SOCIAL ============ */
.insta-pill{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem 1rem;border-radius:999px;
  color:#fff;font-size:.75rem;font-weight:700;
  background:linear-gradient(90deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)}
.insta-pill svg{width:14px;height:14px}
.social-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-bottom:2.5rem}
@media(min-width:768px){.social-grid{grid-template-columns:repeat(4,1fr);gap:1rem}}
.social-item{position:relative;aspect-ratio:1;border-radius:1.25rem;overflow:hidden;display:block}
.social-item img{width:100%;height:100%;object-fit:cover;transition:.7s}
.social-item:hover img{transform:scale(1.06)}
.social-item .cap{position:absolute;inset:auto 0 0 0;padding:.75rem;color:#fff;font-size:.72rem;
  font-weight:500;background:linear-gradient(0deg,rgba(0,31,63,.9),transparent);
  opacity:0;transition:.35s}
.social-item:hover .cap{opacity:1}

/* ============ FAQ ============ */
.faq-wrap{max-width:760px;margin:0 auto}
.faq-item{border:1px solid var(--line);border-radius:1rem;overflow:hidden;margin-bottom:.75rem;background:#fff}
.faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:1.15rem 1.4rem;text-align:left;font-family:var(--font-h);font-weight:600;font-size:.95rem;
  transition:.2s}
.faq-q:hover{background:var(--tint)}
.faq-q svg{width:1.15rem;height:1.15rem;color:var(--blue);flex:none;transition:transform .3s}
.faq-item.open .faq-q svg{transform:rotate(180deg)}
.faq-a{display:none;padding:0 1.4rem 1.25rem;color:rgba(0,31,63,.75);font-size:.9rem;
  border-top:1px solid var(--line);padding-top:1rem}
.faq-item.open .faq-a{display:block}

/* ============ FOOTER ============ */
footer{position:relative;background:var(--navy);color:#fff;overflow:hidden}
.foot-grid{display:grid;gap:2.5rem;grid-template-columns:1fr;position:relative;z-index:2;
  padding:64px 0 48px}
@media(min-width:640px){.foot-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.foot-grid{grid-template-columns:repeat(4,1fr)}}
.foot-brand{display:flex;align-items:center;gap:.6rem;margin-bottom:1rem}
.foot-brand img{width:40px;height:40px;object-fit:contain}
.foot-brand .brand-name{color:#fff}
.foot-brand .brand-name span{color:var(--sky)}
footer p{color:rgba(255,255,255,.5);font-size:.85rem;line-height:1.7}
.foot-h{font-family:var(--font-h);font-weight:700;font-size:.78rem;letter-spacing:.12em;
  text-transform:uppercase;color:rgba(255,255,255,.8);margin-bottom:1rem}
.foot-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.65rem}
.foot-list a,.foot-list li{color:rgba(255,255,255,.5);font-size:.85rem;transition:.25s}
.foot-list a:hover{color:var(--sky)}
.foot-list li{display:flex;align-items:center;gap:.5rem}
.foot-list svg{width:13px;height:13px;color:var(--sky);flex:none}
.foot-contact{display:flex;align-items:center;gap:.75rem;color:rgba(255,255,255,.75);transition:.25s}
.foot-contact:hover{color:var(--sky)}
.foot-contact .ic{width:40px;height:40px;border-radius:.75rem;background:rgba(255,255,255,.06);
  display:grid;place-items:center}
.foot-contact .ic svg{width:16px;height:16px}
.foot-contact .small{font-size:.7rem;color:rgba(255,255,255,.4)}
.foot-contact .big{font-weight:600;font-size:.9rem}
.foot-bottom{position:relative;z-index:2;border-top:1px solid rgba(255,255,255,.1);padding:1.75rem 0;
  display:flex;flex-direction:column;gap:.5rem;align-items:center;justify-content:space-between}
@media(min-width:640px){.foot-bottom{flex-direction:row}}
.foot-bottom p{font-size:.78rem}

/* ============ FLOATING CALL ============ */
.fab{position:fixed;right:20px;bottom:20px;z-index:70;width:56px;height:56px;border-radius:999px;
  background:var(--blue);color:#fff;display:grid;place-items:center;
  box-shadow:0 18px 34px -14px rgba(0,102,204,.9);transition:.3s}
.fab:hover{background:var(--sky);transform:translateY(-2px)}
.fab svg{width:24px;height:24px}

/* ============ MODAL / BOOKING ============ */
.overlay{position:fixed;inset:0;z-index:100;display:none;background:rgba(0,31,63,.55);
  backdrop-filter:blur(6px);overflow-y:auto}
.overlay.open{display:block}
.sheet{background:#fff;border-radius:1.5rem;max-width:900px;margin:32px auto;overflow:hidden;
  box-shadow:0 40px 80px -30px rgba(0,0,0,.5);animation:rise .35s ease}
@keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
.sheet-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:1rem 1.25rem;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:5}
.sheet-head .brand-name{color:var(--navy)}
.sheet-head .brand-name span{color:var(--blue)}
.icon-btn{width:38px;height:38px;border-radius:999px;display:grid;place-items:center;
  background:var(--tint);color:var(--navy);transition:.25s}
.icon-btn:hover{background:rgba(0,102,204,.18)}
.icon-btn svg{width:18px;height:18px}
.steps{display:flex;gap:6px;align-items:center}
.steps i{width:8px;height:8px;border-radius:999px;background:rgba(0,102,204,.2);transition:.3s}
.steps i.on{width:24px;background:var(--blue)}
.step-count{font-size:.75rem;color:var(--muted);font-weight:600;min-width:28px;text-align:right}
.sheet-body{padding:2rem 1.25rem 2.5rem}
@media(min-width:640px){.sheet-body{padding:2.5rem 2rem 3rem}}
.step-head{text-align:center;margin-bottom:2rem}
.step-head h2{font-size:clamp(1.5rem,4vw,1.9rem);font-weight:800}
.step-head p{color:var(--muted);margin-top:.5rem;font-size:.92rem}

.v-grid{display:grid;gap:1rem;grid-template-columns:1fr}
@media(min-width:640px){.v-grid{grid-template-columns:repeat(3,1fr)}}
.v-card{position:relative;padding:2rem 1rem;border-radius:1.15rem;border:2px solid var(--line);
  background:#fff;text-align:center;transition:.3s}
.v-card:hover{border-color:var(--line-strong);box-shadow:0 18px 30px -24px rgba(0,102,204,.8)}
.v-card.sel{border-color:var(--blue);background:rgba(0,102,204,.05);box-shadow:0 18px 34px -26px rgba(0,102,204,.9)}
.v-icon{width:60px;height:60px;border-radius:1rem;background:var(--tint);display:grid;place-items:center;
  margin:0 auto .9rem;transition:.3s;color:var(--blue)}
.v-card.sel .v-icon{background:var(--blue);color:#fff;transform:scale(1.06)}
.v-icon svg{width:26px;height:26px}
.v-card h3{font-size:1.05rem;font-weight:700}
.v-card p{font-size:.8rem;color:var(--muted);margin-top:.2rem}
.tick{position:absolute;top:-1px;right:-1px;width:24px;height:24px;border-radius:999px;background:var(--blue);
  color:#fff;display:grid;place-items:center}
.tick svg{width:12px;height:12px}
.v-type{max-width:22rem;margin:1.5rem auto 0;text-align:center}
.v-type label{display:block;font-size:.85rem;font-weight:600;margin-bottom:.5rem}
.field-label{display:block;font-size:.82rem;font-weight:600;color:var(--navy);margin-bottom:.4rem}
select,input[type=text],input[type=email],input[type=tel],textarea{
  width:100%;border:1.5px solid var(--line);border-radius:.85rem;padding:.85rem 1rem;background:#fff;
  outline:none;transition:.2s;font-size:.92rem}
