  const s = serviceById(id);
  if (!s) return;
  const priceLines = s.sizes.map(x =>
    `<div class="price-line"><span>${x.size === "all" ? "All Vehicles" : x.label}</span><b>${money(x.price)}</b></div>`
  ).join("");
  const addonBlock = s.addons.length ? `
    <div style="margin-top:1.75rem">
      <h4 style="font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.6rem">Optional Add-ons</h4>
      ${s.addons.map(a => `<div class="addon-mini"><span>${a.name}</span><b>${a.label || money(a.price)}</b></div>`).join("")}
    </div>` : "";

  $("#detailBody").innerHTML = `
    <div class="detail-hero"><img src="${s.image}" alt="${s.name}"></div>
    <div class="detail-body">
      <span class="badge" style="position:static;display:inline-block;margin-bottom:.75rem;background:${TIER_GRADIENT[s.tier]}">${s.name}</span>
      <h2>${s.name}</h2>
      <p class="desc">${s.description}</p>
      <div class="detail-cols">
        <div>
          <h4 style="font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.75rem">What's Included</h4>
          <div class="inc-list">${s.includes.map(i => `<div>${ICON.check}<span>${i}</span></div>`).join("")}</div>
          ${addonBlock}
        </div>
        <div>
          <div class="price-box">
            <h4>Pricing</h4>
            ${priceLines}
            <div class="dur-line">${ICON.clock}<span>Approx. ${s.duration} hour${s.duration !== 1 ? "s" : ""}</span></div>
          </div>
          <button class="btn btn-blue" style="width:100%;margin-top:1rem" data-book-service="${s.id}">Book This Service</button>
          <a class="btn btn-outline" style="width:100%;margin-top:.6rem" href="tel:${PHONE}">Call ${PHONE_DISPLAY}</a>
          <p class="muted" style="font-size:.75rem;margin-top:.9rem;text-align:center">Pricing varies with vehicle size and condition.</p>
        </div>
      </div>
    </div>`;
  $("#detailOverlay").classList.add("open");
  document.body.style.overflow = "hidden";
}
function closeDetail() {
  $("#detailOverlay").classList.remove("open");
  document.body.style.overflow = "";
}

/* ================= BOOKING FLOW ================= */
const STEPS = ["Vehicle", "Service", "Add-ons", "Date & Time", "Details", "Confirm"];
const state = {
  step: 0,
  vehicleSize: null,
  vehicleType: "",
  serviceId: null,
  addons: [],
  date: null,
  time: null,
  contact: {},
  done: false,
  calMonth: null
};

function resetBooking() {
  state.step = 0;
  state.vehicleSize = null;
  state.vehicleType = "";
  state.serviceId = null;
  state.addons = [];
  state.date = null;
  state.time = null;
  state.contact = {};
  state.done = false;
  state.calMonth = new Date();
  state.calMonth.setDate(1);
}

function totalPrice() {
  const s = serviceById(state.serviceId);
  if (!s) return 0;
  const base = priceFor(s, state.vehicleSize);
  return base + state.addons.reduce((sum, a) => sum + (a.price || 0), 0);
}
function basePrice() {
  return priceFor(serviceById(state.serviceId), state.vehicleSize);
}

function addonList() {
  const s = serviceById(state.serviceId);
  const list = [];
  if (s) s.addons.forEach(a => list.push({ key: s.id + ":" + a.name, name: a.name, price: a.price, label: a.label, desc: "" }));
  STANDALONE_ADDONS.forEach(a => {
    if (a.requiresPackage && !s) return;
    list.push({ key: a.id, name: a.name, price: a.price, label: a.priceLabel, desc: a.description });
  });
  return list;
}

function canProceed() {
  switch (state.step) {
    case 0: return !!state.vehicleSize;
    case 1: return !!state.serviceId;
    case 2: return true;
    case 3: return !!state.date && !!state.time;
    case 4: return !!(state.contact.name && state.contact.phone && state.contact.address);
    case 5: return true;
    default: return false;
  }
}

function stepVehicle() {
  const cards = [
    { id: "small", label: "Small", sub: "Hatchback & Coupe", icon: ICON.car },
    { id: "medium", label: "Medium", sub: "Sedan & Ute", icon: ICON.car },
    { id: "large", label: "Large", sub: "SUV, 4x4, 7-Seater", icon: ICON.truck }
  ].map(v => `
    <button class="v-card ${state.vehicleSize === v.id ? "sel" : ""}" data-vehicle="${v.id}">
      <div class="v-icon">${v.icon}</div>
      <h3>${v.label}</h3>
      <p>${v.sub}</p>
      ${state.vehicleSize === v.id ? `<span class="tick">${ICON.check}</span>` : ""}
    </button>`).join("");

  const typeBlock = state.vehicleSize ? `
    <div class="v-type">
      <label class="field-label">Select your specific vehicle type</label>
      <select id="vehicleType">
        <option value="">-- Choose vehicle type --</option>
        ${VEHICLE_TYPES[state.vehicleSize].map(t => `<option value="${t}" ${state.vehicleType === t ? "selected" : ""}>${t}</option>`).join("")}
        <option value="Other" ${state.vehicleType === "Other" ? "selected" : ""}>Other</option>
      </select>
      ${state.vehicleType ? `<p style="color:var(--blue);font-size:.82rem;font-weight:600;margin-top:.5rem">✓ ${state.vehicleType} selected</p>` : ""}
    </div>` : "";

  return `
    <div class="step-head">
      <h2>Select Your Vehicle</h2>
      <p>Choose the category that best fits your vehicle for accurate pricing</p>
    </div>
    <div class="v-grid">${cards}</div>
    ${typeBlock}`;
}

function stepService() {
  const cards = SERVICES.map(s => {
    const price = state.vehicleSize ? money(priceFor(s, state.vehicleSize)) : priceRange(s, state.vehicleSize);
    return `
      <button class="b-card ${state.serviceId === s.id ? "sel" : ""}" data-service="${s.id}">
        <div class="top">
          <span class="badge" style="position:static;box-shadow:none;background:${TIER_GRADIENT[s.tier]}">${s.name}</span>
          <span class="price">${price}</span>
        </div>
        <span class="desc">${s.description}</span>
        <span class="dur">${ICON.clock}${s.duration} hour${s.duration !== 1 ? "s" : ""}</span>
      </button>`;
  }).join("");
  return `
    <div class="step-head">
      <h2>Choose Your Service</h2>
      <p>Select a detailing package for your vehicle</p>
    </div>
    <div class="b-grid">${cards}</div>`;
}

function stepAddons() {
  const list = addonList();
  if (!list.length) {
    return `
      <div class="step-head"><h2>Add-ons</h2><p>Nothing extra needed for this package</p></div>
      <div class="empty">No add-ons are available for this service — continue when you're ready.</div>`;
  }
  const items = list.map(a => {
    const selected = state.addons.some(x => x.key === a.key);
    const priceText = a.price == null ? (a.label || "Variable") : money(a.price);
    return `
      <button class="addon ${selected ? "sel" : ""}" data-addon="${a.key}">
        <span class="box">${ICON.check}</span>
        <span class="txt">
          <span class="nm">${a.name}</span>
          ${a.desc ? `<span class="ds">${a.desc}</span>` : ""}
        </span>
        <span class="pr">${priceText}</span>
      </button>`;
  }).join("");
  return `
    <div class="step-head"><h2>Enhance Your Detail</h2><p>Optional extras to complete the job</p></div>
    ${items}`;
}

function bookedCountByDate() {
  const map = {};
  loadBookings().forEach(b => {
    if (b.status === "cancelled") return;
    map[b.date] = (map[b.date] || 0) + 1;
  });
  return map;
}
function isDayDisabled(d) {
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const tomorrow = new Date(today); tomorrow.setDate(today.getDate() + 1);
  if (d < tomorrow) return true;
  if (d.getDay() === 0) return true; // Sundays closed
  return false;
}

function calendarHTML() {
  const month = state.calMonth;
  const y = month.getFullYear();
  const m = month.getMonth();
  const monthLabel = month.toLocaleDateString("en-AU", { month: "long", year: "numeric" });
  const first = new Date(y, m, 1);
  const offset = (first.getDay() + 6) % 7; // Monday-first
  const days = new Date(y, m + 1, 0).getDate();
  const counts = bookedCountByDate();
  const dow = ["M", "T", "W", "T", "F", "S", "S"].map(d => `<div class="dow">${d}</div>`).join("");
  let cells = "";
  for (let i = 0; i < offset; i++) cells += `<div></div>`;
  for (let day = 1; day <= days; day++) {
    const d = new Date(y, m, day);
    const key = isoDate(d);
    const disabled = isDayDisabled(d);
    const booked = counts[key] || 0;
    const avail = TIME_SLOTS.length - booked;
    const level = avail <= 0 ? "full" : avail <= 2 ? "limited" : "open";
    const dot = (!disabled && level) ? `<span class="dot ${level}"></span>` : "";
    cells += `<button class="day ${state.date === key ? "sel" : ""}" data-day="${key}" ${disabled || avail <= 0 ? "disabled" : ""}>
        ${day}${dot}</button>`;
  }
  return `
    <div class="cal">
      <div class="cal-top">
        <strong>${monthLabel}</strong>
        <div class="cal-nav">
          <button data-cal="-1" aria-label="Previous month">${ICON.left}</button>
          <button data-cal="1" aria-label="Next month">${ICON.right}</button>
        </div>
      </div>
      <div class="cal-grid">${dow}${cells}</div>
    </div>`;
}

function stepDateTime() {
  const counts = bookedCountByDate();
  let right;
  if (state.date) {
    const taken = new Set(bookingsOn(state.date).map(b => b.time));
    const available = TIME_SLOTS.filter(t => !taken.has(t));
    const chips = TIME_SLOTS.map(t => {
      const busy = taken.has(t);
      return `<button class="slot ${state.time === t ? "sel" : ""}" data-time="${t}" ${busy ? "disabled" : ""}>${t}</button>`;
    }).join("");
    const level = available.length === 0 ? "none" : available.length <= 2 ? "low" : "ok";
    right = `
      <div>
        <div class="slot-note">
          <strong>${parseISO(state.date).toLocaleDateString("en-AU", { weekday: "long", month: "long", day: "numeric" })}</strong>
          <span class="pillcount ${level}">${available.length} slot${available.length !== 1 ? "s" : ""} available</span>
        </div>
        ${available.length
          ? `<div class="slots">${chips}</div>`
          : `<div class="slots-empty">${ICON.info} No available times for this date. Please select another date.</div>`}
      </div>`;
  } else {
    right = `
      <div style="display:flex;align-items:center;justify-content:center;height:100%;text-align:center;color:var(--muted)">
        <div>
          <div style="color:rgba(0,102,204,.35);margin-bottom:.75rem">${ICON.clock}</div>
          <p>Select a date to see available times</p>
          <p style="font-size:.78rem;opacity:.7;margin-top:.4rem">Colour dots show day availability</p>
        </div>
      </div>`;
  }
  return `
    <div class="step-head"><h2>Pick Your Date &amp; Time</h2><p>Select your preferred appointment slot</p></div>
    <div class="legend">
      <span><i style="background:#34d399"></i> Available</span>
      <span><i style="background:#fbbf24"></i> Limited (1–2 slots)</span>
      <span><i style="background:#f87171"></i> Fully Booked</span>
    </div>
    <div class="cal-wrap">${calendarHTML()}${right}</div>`;
}

function stepDetails() {
  const c = state.contact;
  return `
    <div class="step-head"><h2>Your Details</h2><p>Enter your contact information and service address</p></div>
    <div class="form-wrap">
      <div class="form-row">
        <label>Full Name <span class="req">*</span></label>
        <input type="text" data-field="name" value="${c.name || ""}" placeholder="John Smith" autocomplete="name">
      </div>
      <div class="form-row">
        <label>Phone Number <span class="req">*</span></label>
        <input type="tel" data-field="phone" value="${c.phone || ""}" placeholder="04XX XXX XXX" autocomplete="tel">
      </div>
      <div class="form-row">
        <label>Email Address</label>
        <input type="email" data-field="email" value="${c.email || ""}" placeholder="john@example.com" autocomplete="email">
      </div>
      <div class="form-row">
        <label>Service Address <span class="req">*</span></label>
        <input type="text" data-field="address" value="${c.address || ""}" placeholder="123 Main Street, Brisbane" autocomplete="street-address">
      </div>
      <div class="form-row">
        <label>Vehicle Make &amp; Model</label>
        <input type="text" data-field="vehicle" value="${c.vehicle || ""}" placeholder="e.g. Toyota Camry 2022">
      </div>
      <div class="form-row">
        <label>Additional Notes</label>
        <textarea data-field="notes" placeholder="Any special requests or details about your vehicle...">${c.notes || ""}</textarea>
      </div>
    </div>`;
}

function summaryRows() {
  const s = serviceById(state.serviceId);
  const vehicleLabel = { small: "Small", medium: "Medium", large: "Large" }[state.vehicleSize] || "—";
  const vehicle = state.contact.vehicle || state.vehicleType;
  return `
    <div class="sum-row"><span class="k">Service</span><span class="v">${s ? s.name : "—"}</span></div>
    <div class="sum-row"><span class="k">Date</span><span class="v">${state.date ? longDate(state.date) : "—"}</span></div>
    <div class="sum-row"><span class="k">Time</span><span class="v">${state.time || "—"}</span></div>
    <div class="sum-row"><span class="k">Vehicle</span><span class="v">${vehicleLabel}${vehicle ? " — " + vehicle : ""}</span></div>
    <div class="sum-row"><span class="k">Name</span><span class="v">${state.contact.name || "—"}</span></div>
    <div class="sum-row"><span class="k">Phone</span><span class="v">${state.contact.phone || "—"}</span></div>
    ${state.contact.email ? `<div class="sum-row"><span class="k">Email</span><span class="v">${state.contact.email}</span></div>` : ""}
    <div class="sum-row"><span class="k">Address</span><span class="v">${state.contact.address || "—"}</span></div>
    ${state.addons.length ? `<div class="sum-row"><span class="k">Add-ons</span><span class="v">${state.addons.map(a => `${a.name}${a.price != null ? " (" + money(a.price) + ")" : " (TBD)"}`).join("<br>")}</span></div>` : ""}
    ${state.contact.notes ? `<div class="sum-row"><span class="k">Notes</span><span class="v">${state.contact.notes}</span></div>` : ""}
    <div class="sum-total"><span class="k">Estimated Total</span><span class="v">${money(totalPrice())}</span></div>`;
}

function stepConfirm() {
  return `
    <div class="step-head"><h2>Review Your Booking</h2><p>Check the details below, then send your request</p></div>
    <div class="sum-card">${summaryRows()}</div>
    <p class="muted" style="text-align:center;font-size:.78rem;margin-top:1rem">
      Final pricing may vary with vehicle condition. We'll confirm by phone or text.
    </p>`;
}

function stepSuccess() {
  return `
    <div class="success">
      <div class="circle">${ICON.check}</div>
      <h2>Booking Request Ready!</h2>
      <p>Thanks ${state.contact.name || "there"}! Send this through and we'll confirm your appointment shortly.</p>
      <div class="sum-card">${summaryRows()}</div>
      <div class="success-actions">
        <a class="btn btn-blue" href="${mailtoLink()}" id="mailtoBtn">Email Booking to Hydro</a>
        <a class="btn btn-outline" href="sms:${PHONE}?&body=${encodeURIComponent(smsBody())}">Text Us</a>
        <a class="btn btn-outline" href="tel:${PHONE}">Call ${PHONE_DISPLAY}</a>
      </div>
      <p class="toast-note">Your details are saved on this device. To secure the slot instantly, tap call or text.</p>
    </div>`;
}

function emailBody() {
  const s = serviceById(state.serviceId);
  const veh = [state.vehicleSize, state.contact.vehicle || state.vehicleType].filter(Boolean).join(" — ");
  const addons = state.addons.length
    ? state.addons.map(a => "  • " + a.name + (a.price != null ? " (+" + money(a.price) + ")" : " (TBD)")).join("\n")
    : "  None";
  return `New booking request\n\nCLIENT DETAILS\nName: ${state.contact.name}\nPhone: ${state.contact.phone}\nEmail: ${state.contact.email || "Not provided"}\nAddress: ${state.contact.address}\n\nBOOKING DETAILS\nService: ${s ? s.name : ""}\nDate: ${state.date ? longDate(state.date) : ""}\nTime: ${state.time}\nVehicle: ${veh}\n\nAdd-ons:\n${addons}\n\nEstimated Total: ${money(totalPrice())}${state.contact.notes ? "\n\nNotes: " + state.contact.notes : ""}`;
}
function mailtoLink() {
  return "mailto:" + EMAIL + "?subject=" + encodeURIComponent("Booking Request – " + (state.contact.name || "") + " – " + (state.date ? shortDate(state.date) : "")) + "&body=" + encodeURIComponent(emailBody());
}
function smsBody() { return emailBody(); }

/* ---- render loop ---- */
function renderBooking() {
  const body = $("#bookBody");
  const foot = $("#bookFoot");
  const dots = $("#stepDots");

  dots.innerHTML = STEPS.map((s, i) => `<i class="${i === state.step ? "on" : ""}"></i>`).join("");
  $("#stepCount").textContent = state.done ? "✓" : (state.step + 1) + "/" + STEPS.length;

  if (state.done) {
    body.innerHTML = stepSuccess();
    foot.hidden = true;
    return;
  }
  foot.hidden = false;

  if (state.step === 0) body.innerHTML = stepVehicle();
  else if (state.step === 1) body.innerHTML = stepService();
  else if (state.step === 2) body.innerHTML = stepAddons();
  else if (state.step === 3) body.innerHTML = stepDateTime();
  else if (state.step === 4) body.innerHTML = stepDetails();
  else body.innerHTML = stepConfirm();

  updateNav();
}

function updateNav() {
  const hasService = !!state.serviceId;
  $("#miniTotal").innerHTML = hasService
    ? `<span class="amt">${money(totalPrice())}</span><span class="cap">estimated total</span>`
    : "";
  $("#btnBack").hidden = state.step === 0;
  const next = $("#btnNext");
  if (state.step === 5) {
    next.innerHTML = "Confirm Booking";
    next.className = "btn btn-blue";
    next.disabled = false;
  } else {
    next.innerHTML = "Continue" + ICON.arrow;
    next.className = "btn btn-navy";
    next.disabled = !canProceed();
  }
}

function openBooking(serviceId) {
  resetBooking();
  if (serviceId && serviceById(serviceId)) {
    state.serviceId = serviceId;
    state.step = 1;
  }
  $("#bookOverlay").classList.add("open");
  document.body.style.overflow = "hidden";
  renderBooking();
  $("#bookOverlay").scrollTop = 0;
}
function closeBooking() {
  $("#bookOverlay").classList.remove("open");
  document.body.style.overflow = "";
}

function submitBooking() {
  const s = serviceById(state.serviceId);
  saveBooking({
    id: "b_" + Date.now(),
    created: new Date().toISOString(),
    date: state.date,
    time: state.time,
    service: s ? s.name : "",
    vehicleSize: state.vehicleSize,
    vehicleType: state.vehicleType,
    vehicle: state.contact.vehicle || "",
    name: state.contact.name,
    phone: state.contact.phone,
    email: state.contact.email || "",
    address: state.contact.address,
    notes: state.contact.notes || "",
    addons: state.addons.map(a => ({ name: a.name, price: a.price })),
    total: totalPrice(),
    status: "pending"
  });
  state.done = true;
  renderBooking();
  $("#bookOverlay").scrollTop = 0;
}

/* ================= EVENTS ================= */
document.addEventListener("click", (e) => {
  const t = e.target;

  // scroll links
  const scrollBtn = t.closest("[data-scroll]");
  if (scrollBtn) {
    const target = document.querySelector(scrollBtn.dataset.scroll);
    if (target) target.scrollIntoView({ behavior: "smooth" });
    $("#mobileMenu").classList.remove("open");
    return;
  }

  // open booking
  const bookBtn = t.closest("[data-book-open]");
  if (bookBtn) {
    e.preventDefault();
    openBooking(null);
    $("#mobileMenu").classList.remove("open");
    return;
  }
  // book specific service
  const bookSvc = t.closest("[data-book-service]");
  if (bookSvc) {
    e.preventDefault();
    closeDetail();
    openBooking(bookSvc.dataset.bookService);
    return;
  }
  // service detail
  const detailBtn = t.closest("[data-detail]");
  if (detailBtn) { openDetail(detailBtn.dataset.detail); return; }

  // faq
  const faqQ = t.closest(".faq-q");
  if (faqQ) {
    const item = faqQ.closest(".faq-item");
    const wasOpen = item.classList.contains("open");
    $$(".faq-item").forEach(i => i.classList.remove("open"));
    if (!wasOpen) item.classList.add("open");
    return;
  }

  // vehicle select
  const vCard = t.closest("[data-vehicle]");
  if (vCard) {
    state.vehicleSize = vCard.dataset.vehicle;
    state.vehicleType = "";
    renderBooking();
    return;
  }

  // booking service select
  const svcBtn = t.closest("[data-service]");
  if (svcBtn) {
    state.serviceId = svcBtn.dataset.service;
    state.addons = [];
    renderBooking();
    return;
  }

  // addon toggle
  const addonBtn = t.closest("[data-addon]");
  if (addonBtn) {
    const key = addonBtn.dataset.addon;
    const list = addonList();
    const found = list.find(a => a.key === key);
    if (found) {
      const exists = state.addons.some(a => a.key === key);
      if (exists) state.addons = state.addons.filter(a => a.key !== key);
      else state.addons.push({ key: found.key, name: found.name, price: found.price });
    }
    addonBtn.classList.toggle("sel");
    updateNav();
    return;
  }

  // calendar month nav
  const calBtn = t.closest("[data-cal]");
  if (calBtn) {
    const dir = Number(calBtn.dataset.cal);
    const nm = new Date(state.calMonth.getFullYear(), state.calMonth.getMonth() + dir, 1);
    const today = new Date(); today.setDate(1); today.setHours(0, 0, 0, 0);
    if (nm >= today) state.calMonth = nm;
    renderBooking();
    return;
  }

  // day select
  const dayBtn = t.closest("[data-day]");
  if (dayBtn) {
    state.date = dayBtn.dataset.day;
    state.time = null;
    renderBooking();
    return;
  }

  // time select
  const timeBtn = t.closest("[data-time]");
  if (timeBtn) {
    state.time = timeBtn.dataset.time;
    renderBooking();
    return;
  }
});

// contact inputs (no re-render -> keeps focus)
document.addEventListener("input", (e) => {
  const f = e.target.closest("[data-field]");
  if (!f) return;
  state.contact[f.dataset.field] = f.value;
  updateNav();
});

// vehicle type select
document.addEventListener("change", (e) => {
  if (e.target.id === "vehicleType") {
    state.vehicleType = e.target.value;
    renderBooking();
  }
});

// nav buttons
$("#btnNext").addEventListener("click", () => {
  if (state.step === 5) { submitBooking(); return; }
  if (!canProceed()) return;
  state.step = Math.min(state.step + 1, 5);
  renderBooking();
  $("#bookOverlay").scrollTop = 0;
});
$("#btnBack").addEventListener("click", () => {
  state.step = Math.max(state.step - 1, 0);
  renderBooking();
  $("#bookOverlay").scrollTop = 0;
});
$("#closeBooking").addEventListener("click", closeBooking);
$("#closeDetail").addEventListener("click", closeDetail);

$("#bookOverlay").addEventListener("click", (e) => { if (e.target.id === "bookOverlay") closeBooking(); });
$("#detailOverlay").addEventListener("click", (e) => { if (e.target.id === "detailOverlay") closeDetail(); });
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") { closeBooking(); closeDetail(); $("#mobileMenu").classList.remove("open"); }
});

// header + mobile menu
const header = $("#header");
const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 40);
window.addEventListener("scroll", onScroll);
onScroll();

$("#burger").addEventListener("click", () => $("#mobileMenu").classList.toggle("open"));

// promo countdown (hidden once the offer date passes)
const DEAL_END = new Date("2026-07-31T23:59:59");
function tickCountdown() {
  const promo = $("#promo");
  const diff = DEAL_END - new Date();
  if (diff <= 0) { promo.hidden = true; return; }
  promo.hidden = false;
  const days = Math.floor(diff / 86400000);
  const hours = Math.floor((diff % 86400000) / 3600000);
  const mins = Math.floor((diff % 3600000) / 60000);
  const secs = Math.floor((diff % 60000) / 1000);
  const pad = n => String(n).padStart(2, "0");
  $("#countdown").textContent = days + "d : " + pad(hours) + "h : " + pad(mins) + "m : " + pad(secs) + "s";
}
setInterval(tickCountdown, 1000);

// reveal on scroll
function initReveal() {
  const els = $$(".reveal");
  if (!("IntersectionObserver" in window)) { els.forEach(el => el.classList.add("in")); return; }
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add("in"); io.unobserve(entry.target); }
    });
  }, { threshold: 0.12 });
  els.forEach(el => io.observe(el));
}

/* ================= INIT ================= */
renderServices();
renderWhy();
renderReviews();
renderSocial();
renderFaq();
renderAreas();
$("#year").textContent = new Date().getFullYear();
tickCountdown();
initReveal();
</script>
