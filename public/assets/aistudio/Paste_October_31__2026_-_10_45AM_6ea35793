/* ================= HELPERS ================= */
const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
const money = n => "$" + n;

function isoDate(d) {
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
}
function parseISO(s) {
  const [y, m, d] = s.split("-").map(Number);
  return new Date(y, m - 1, d);
}
function longDate(s) {
  return parseISO(s).toLocaleDateString("en-AU", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
}
function shortDate(s) {
  return parseISO(s).toLocaleDateString("en-AU", { weekday: "short", day: "numeric", month: "short" });
}
function serviceById(id) { return SERVICES.find(s => s.id === id); }
function priceFor(service, size) {
  if (!service) return 0;
  const match = service.sizes.find(s => s.size === size);
  return match ? match.price : service.sizes[0].price;
}
function priceRange(service, size) {
  const list = size ? service.sizes.filter(s => s.size === size || s.size === "all") : service.sizes;
  const sizes = list.length ? list : service.sizes;
  if (sizes.length === 1) return money(sizes[0].price);
  const min = Math.min(...sizes.map(s => s.price));
  const max = Math.max(...sizes.map(s => s.price));
  return min === max ? money(min) : money(min) + "–" + money(max);
}

